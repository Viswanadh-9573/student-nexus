{
  "name": "student-nexus-mern",
  "version": "1.0.0",
  "description": "StudentNexus - LinkedIn-Themed Collegiate MERN Network with Skill Showcases & Hackathons",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node --watch server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["mern", "linkedin-clone", "student-portfolio", "hackathons", "react", "express", "mongodb"],
  "author": "",
  "license": "MIT"
}
